# Copy to .env on the Raspberry Pi or laptop. Never commit the real .env file.
ROBOT_MODE=demo
ROBOT_FULLSCREEN=1
ROBOT_SCALE=1
ROBOT_START_SCREEN=idle

# Push-to-talk button, BCM pin number (physical pin 11 is GPIO 17).
ROBOT_PTT_PIN=17

# Get a key at https://console.x.ai  Never commit the real key.
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1
XAI_TTS_VOICE=eve

# Create an app at https://developer.spotify.com/dashboard
# Register this exact redirect URI in the Spotify dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback
SPOTIFY_TOKEN_FILE=.spotify-token.json
